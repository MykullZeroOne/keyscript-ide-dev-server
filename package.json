{
  "name": "keyscript-dev-server",
  "version": "1.1.0",
  "description": "",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "start": "electron-vite dev",
    "server": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 node ./server/main.js",
    "build:server": "npx esbuild src/server/index.ts --bundle --platform=node --format=esm --outdir=out/server --external:esbuild --external:node-pty --external:express-http-proxy --external:sprightly --external:ws --packages=external --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "build:web": "electron-vite build && npm run build:server",
    "start:web": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 ROOT_PATH=. node out/server/index.js",
    "docker:build": "docker build --build-arg APP_VERSION=$(node -p \"require('./package.json').version\") -t keyscript-ide .",
    "docker:run": "docker compose up -d",
    "docker:stop": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy": "./scripts/deploy.sh",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "package:linux": "electron-vite build && electron-builder --linux"
  },
  "keywords": [],
  "author": "",
  "license": "See license.md",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/archiver": "^7.0.0",
    "@types/multer": "^2.1.0",
    "allotment": "^1.20.5",
    "archiver": "^7.0.1",
    "body-parser": "^1.20.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "esbuild": "^0.27.3",
    "express": "^4.22.1",
    "express-http-proxy": "^2.1.2",
    "express-session": "^1.19.0",
    "lucide-react": "^0.577.0",
    "multer": "^2.1.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sprightly": "^2.0.1",
    "tailwindcss": "^4.2.1",
    "ws": "^8.19.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-http-proxy": "^1.6.7",
    "@types/express-session": "^1.18.2",
    "@types/node": "^20.19.35",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "cross-env": "^7.0.3",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
