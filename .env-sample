# The server will also acquire one additional port in order to emulate the Corelation Windows service.
# This secondary port will be the port number specified here plus one, i.e. 3001 in this example. 
PORT=3000

# Replace this value with your internal keystone endpoint. An IP address or DNS alias will also work.
PROXY_ENDPOINT=keystone.mycu.org:8443

# Include any databases/instances you want the server to support. "Live" is disabled to prevent
# accidentally running work-in-process code against production, but any/all other instances are valid.
SUPPORTED_INSTANCES=Test|Train

# Optional: Override the auto-detected device ID (MAC address). Leave blank to auto-detect.
DEVICE_ID=

# Set to true to bypass Kerberos/AD auto-login and go straight to username/password dialog.
BYPASS_KERBEROS=false

# Set to true to run the Corelation service mock on port 51763 (HTTPS) so the real
# Keystone web app works on Mac. A self-signed certificate is generated automatically.
# After starting, visit https://127.0.0.1:51763 in your browser and accept the cert,
# then navigate to your Keystone URL (e.g. https://keystonedev.revfcu.com:8443/Development/).
STANDALONE_SERVICE=false
